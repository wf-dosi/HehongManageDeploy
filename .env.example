# 外层只管理中间件及部署参数；bash install.sh 首次生成 .env。
# 密码从 /dev/urandom 独立生成；已有 .env 保留。
TZ=Asia/Shanghai
HTTP_PORT=80

# 容器镜像
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
NGINX_IMAGE=nginx:stable-alpine

# MySQL：DB_USERNAME 为应用专用账号，不能填写 root。
MYSQL_PORT=3306
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hehong
DB_USERNAME=hehong
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=hehong
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=hehong

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_REDIS_DB=0
CELERY_RESULT_REDIS_DB=1
